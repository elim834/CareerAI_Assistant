<Window x:Class="frontend.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CareerAI — Home" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TodayText" Grid.Column="0"
                       FontSize="22" FontWeight="Bold"/>
            <Button x:Name="OpenApplicationsButton" Grid.Column="1"
                    Content="Applications Table" Padding="12,6"
                    Click="OpenApplicationsButton_Click"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Calendar column -->
            <StackPanel Grid.Column="0">
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀" Width="30" Click="PrevMonth_Click"/>
                            <TextBlock Grid.Column="1" x:Name="MonthLabel" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶" Width="30" Click="NextMonth_Click"/>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="Gray"/>
                        </UniformGrid>

                        <ItemsControl x:Name="CalendarGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Selected day details -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6"
                        Padding="15" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SelectedDayHeader" FontWeight="Bold" Margin="0,0,0,8"
                                   Text="Select a day"/>
                        <ItemsControl x:Name="SelectedDayList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column: recommendations + priority list -->
            <StackPanel Grid.Column="2">
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Recommendations" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="RecommendationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding IconText}" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Width="480"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoRecommendationsText" Text="Everything looks good — no urgent items."
                                   Foreground="Gray" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Priority Order" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="PriorityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,8"
                                            Cursor="Hand" MouseLeftButtonUp="PriorityItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PriorityIcon}"
                                                       Margin="0,0,10,0" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DaysLeftDisplay}"
                                                       Foreground="Gray"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ScoreDisplay}"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>