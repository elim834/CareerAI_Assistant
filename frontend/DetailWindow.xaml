<Window x:Class="frontend.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Details" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Acceptance Score" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBlock x:Name="ScoreText" FontSize="16"/>

            <TextBlock Text="Reasoning" FontWeight="Bold" Margin="0,15,0,2"/>
            <TextBlock x:Name="ReasoningText" TextWrapping="Wrap"/>

            <TextBlock Text="Visa Summary" FontWeight="Bold" Margin="0,15,0,2"/>
            <TextBlock x:Name="VisaText" TextWrapping="Wrap"/>

            <TextBlock Text="Suggested Focus" FontWeight="Bold" Margin="0,15,0,2"/>
            <TextBlock x:Name="FocusText" TextWrapping="Wrap"/>
            <TextBlock Text="Risks" FontWeight="Bold" Margin="0,15,0,2"/>
            <ItemsControl x:Name="RisksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StringFormat='• {0}'}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Action Plan (2-4 weeks)" FontWeight="Bold" Margin="0,15,0,2"/>
            <ItemsControl x:Name="ActionPlanList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StringFormat='✓ {0}'}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Program Details" FontWeight="Bold" Margin="0,20,0,2"/>
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap"/>
            
            <TextBlock Text="Sub Role / Specialization" FontWeight="Bold" Margin="0,20,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SubRoleTextBox" Width="300" Padding="5"/>
                <Button Content="Save" Padding="10,5" Margin="10,0,0,0" Click="SaveSubRoleButton_Click"/>
                <Button Content="Generate Cover Letter Draft" Padding="15,5" Margin="0,15,0,0"
                        HorizontalAlignment="Left" Click="GenerateCoverLetterButton_Click"/>
            </StackPanel>
            
            <Button Content="Delete the application" Padding="15,5" Margin="0,25,10,0"
                    Background="#FFCDD2"
                    HorizontalAlignment="Right" Click="DeleteButton_Click"/>

            <Button Content="Close" Padding="15,5" Margin="0,25,0,0"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>