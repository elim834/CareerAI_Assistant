<Window x:Class="frontend.LastAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Last Analysis" Height="480" Width="500"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="TimestampText" Foreground="Gray" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock x:Name="NoAnalysisText" Text="This application hasn't been analyzed yet."
                       Visibility="Collapsed" Margin="0,0,0,15"/>

            <StackPanel x:Name="AnalysisPanel">
                <TextBlock Text="Acceptance Score" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="ScoreText" FontSize="16" Margin="0,0,0,12"/>

                <TextBlock Text="Reasoning" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="ReasoningText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Language Requirement" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="LanguageText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Visa Summary" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="VisaText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Suggested Focus" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="FocusText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Risks" FontWeight="Bold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="RisksList" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <Binding StringFormat="• {0}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Action Plan" FontWeight="Bold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="ActionPlanList" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <Binding StringFormat="✓ {0}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Separator Margin="0,10,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GoToApplicationsButton" Content="Go to Applications Table"
                        Padding="12,6" Margin="0,0,10,0" Click="GoToApplicationsButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Padding="12,6" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>