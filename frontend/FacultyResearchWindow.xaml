<Window x:Class="frontend.FacultyResearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Faculty and Lab Research" Height="550" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Search for a professor, lab, or research group"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="QueryTextBox" Width="420" Padding="6"
                     VerticalContentAlignment="Center"
                     ToolTip="e.g. 'Prof. Jane Doe MIT computer vision lab'"/>
            <Button x:Name="SearchButton" Content="Search" Padding="14,6"
                    Margin="10,0,0,0" Click="SearchButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel">
                <TextBlock x:Name="StatusText" Foreground="Gray"/>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ResearcherNameText" FontSize="18" FontWeight="Bold"
                               Margin="0,10,0,10"/>

                    <TextBlock Text="Summary" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <TextBlock Text="Recent Topics" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="TopicsList" Margin="0,0,0,15">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <Binding StringFormat="• {0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sources" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="SourcesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="{Binding}" Foreground="#1565C0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>