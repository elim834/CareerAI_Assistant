<Window x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:frontend.Converters"
        Title="CareerAI Assistant" Height="600" Width="1100">
    
    <Window.Resources>
        <conv:UrgencyColorConverter x:Key="UrgencyColorConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" FontSize="14" Margin="0,0,0,10"
                   Text="Connecting to backend..."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="HomeButton" Content="🏠 Home" Padding="10,5" Margin="0,0,10,0"
                    Click="HomeButton_Click"/>
            <Button x:Name="UploadTranscriptButton" Content="Upload Transcript"
                    Padding="10,5" Margin="0,0,10,0"
                    Click="UploadTranscriptButton_Click"/>
            <Button x:Name="UploadCvButton" Content="Upload CV"
                    Padding="10,5"
                    Click="UploadCvButton_Click"/>
            <Button x:Name="FacultyResearchButton" Content="🔬 Faculty Research"
                    Padding="10,5" Click="FacultyResearchButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="ScanUrlTextBox" Width="500" Padding="5"
                     Margin="0,0,10,0"
                     Text=""
                     VerticalContentAlignment="Center"/>
            <Button x:Name="ScanUrlButton" Content="Scan URL"
                    Padding="10,5" Click="ScanUrlButton_Click"/>
        </StackPanel>
        
        <Button x:Name="ExportButton" Content="Export to Excel" Grid.Row="3"
                Padding="10,5" Margin="0,0,0,10" HorizontalAlignment="Left"
                Click="ExportButton_Click"/>
        
        <Button x:Name="KanbanButton" Content="Kanban View" Grid.Row="3"
                Padding="10,5" Margin="120,0,0,10" HorizontalAlignment="Left"
                Click="KanbanButton_Click"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ShowAllButton" Content="All" Padding="10,5" Margin="0,0,5,0"
                    Click="ShowAllButton_Click"/>
            <Button x:Name="ShowMastersButton" Content="Master's Programs" Padding="10,5" Margin="0,0,5,0"
                    Click="ShowMastersButton_Click"/>
            <Button x:Name="ShowInternshipsButton" Content="Internships" Padding="10,5"
                    Click="ShowInternshipsButton_Click"/>
        </StackPanel>
        
        <DataGrid x:Name="ApplicationsGrid" Grid.Row="5"
          AutoGenerateColumns="False" IsReadOnly="True"
          CanUserAddRows="False"
          MouseDoubleClick="ApplicationsGrid_MouseDoubleClick"
          PreviewMouseRightButtonDown="ApplicationsGrid_PreviewMouseRightButtonDown">
    <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding DaysLeft, Converter={StaticResource UrgencyColorConverter}}"/>
        </Style>
    </DataGrid.RowStyle>
    <DataGrid.Resources>
        <Style x:Key="WrapCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </DataGrid.Resources>
    <DataGrid.Columns>
        <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="Auto" MinWidth="60" MaxWidth="120" ElementStyle="{StaticResource WrapCellStyle}"/>
        <DataGridTextColumn Header="University" Binding="{Binding University}" Width="Auto" MinWidth="120" MaxWidth="220" ElementStyle="{StaticResource WrapCellStyle}"/>
        <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="Auto" MinWidth="150" MaxWidth="280" ElementStyle="{StaticResource WrapCellStyle}"/>
        <DataGridTextColumn Header="Scholarship" Binding="{Binding ScholarshipAmount}" Width="Auto" MinWidth="100" MaxWidth="220" ElementStyle="{StaticResource WrapCellStyle}"/>
        <DataGridTextColumn Header="Tuition" Binding="{Binding Tuition}" Width="Auto" MinWidth="100" MaxWidth="220" ElementStyle="{StaticResource WrapCellStyle}"/>
        <DataGridTextColumn Header="TOEFL" Binding="{Binding ToeflRequirement}" Width="Auto" MinWidth="50"/>
        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="Auto" MinWidth="80"/>
        <DataGridTextColumn Header="Days Left" Binding="{Binding DaysLeftDisplay}" Width="Auto" MinWidth="70"/>
        <DataGridTextColumn Header="Visa" Binding="{Binding VisaCountry}" Width="Auto" MinWidth="60"/>
        <DataGridTextColumn Header="Score" Binding="{Binding AcceptanceScore}" Width="Auto" MinWidth="50"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="70"/>
    </DataGrid.Columns>
</DataGrid>
    </Grid>
</Window>