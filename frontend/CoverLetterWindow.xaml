<Window x:Class="frontend.CoverLetterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cover Letter Draft" Height="650" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Opening" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="OpeningText" TextWrapping="Wrap" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,15"/>

                <TextBlock Text="Body" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="BodyText" TextWrapping="Wrap" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,15"/>

                <TextBlock Text="Lab / Program Fit" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="LabFitText" TextWrapping="Wrap" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,15"/>

                <TextBlock Text="Closing" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="ClosingText" TextWrapping="Wrap" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Margin="0,0,0,15"/>

                <TextBlock Text="You should personally add:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ItemsControl x:Name="KeyPointsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <Binding StringFormat="• {0}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="CopyAllButton" Content="Copy Full Letter" Padding="12,6"
                    Margin="0,0,10,0" Click="CopyAllButton_Click"/>
            <Button Content="Close" Padding="12,6" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>